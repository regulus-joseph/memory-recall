{
  "id": "memory-recall",
  "name": "Memory Recall",
  "description": "L1/L2/L3 cascade memory recall plugin: vector (Qdrant) + BM25 (jieba) + graph expansion (graphify). Requires memory-recall-server (Python) running on port 8765.",
  "version": "0.2.0",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serverUrl": {
        "type": "string",
        "default": "http://localhost:8765",
        "description": "Memory Recall Python server URL"
      },
      "autoStore": {
        "type": "boolean",
        "default": true,
        "description": "Automatically store user/assistant messages"
      },
      "autoRecall": {
        "type": "boolean",
        "default": true,
        "description": "Automatically inject relevant memories before each reply"
      },
      "autoRecallMaxItems": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 3,
        "description": "Maximum memories to inject per turn"
      },
      "autoRecallMaxChars": {
        "type": "integer",
        "minimum": 64,
        "maximum": 8000,
        "default": 600,
        "description": "Maximum total characters injected"
      },
      "l1": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "minScore": { "type": "number", "default": 0.0 }
        }
      },
      "l2": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "minScore": { "type": "number", "default": 0.3 }
        }
      },
      "l3": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "triggerThreshold": { "type": "number", "default": 0.6 }
        }
      }
    }
  },
  "uiHints": {
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Automatically inject relevant memories before each reply"
    },
    "autoRecallMaxItems": {
      "label": "Max Memory Items",
      "help": "Maximum memories to inject per turn"
    },
    "autoRecallMaxChars": {
      "label": "Max Characters",
      "help": "Maximum total characters injected"
    }
  }
}